{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "noEmitOnError": true,
        "rootDir": "src",
        "outDir": "web",
        "types": []
    },
    "include": [
        "src/app.ts",
        "src/tags.ts",
        "src/processor.ts",
        "src/bootstrap.ts",
        "src/globals.d.ts",
        "src/audio-worklet.d.ts"
    ]
}
